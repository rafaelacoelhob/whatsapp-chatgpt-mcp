# Copie este arquivo para .env e preencha. Gere senhas longas e aleatórias
# (ex. no PowerShell:  -join ((48..57)+(97..122) | Get-Random -Count 40 | % {[char]$_})  )

# Senha do banco Postgres interno (ninguém digita, só o sistema usa)
POSTGRES_PASSWORD=

# "Senha mestra" da Evolution API (usada p/ acessar o painel e pela integração)
EVOLUTION_API_KEY=

# Nome da instância do WhatsApp (uma por número conectado)
EVOLUTION_INSTANCE=ana

# Segredo que protege a URL do conector do ChatGPT
# (a URL final fica: https://SEU-DOMINIO/mcp/ESTE-SEGREDO)
MCP_PATH_SECRET=

# Números que o ChatGPT NUNCA pode ler (com DDI, separados por vírgula).
# Ex: 5511999999999,5521888888888 — pode deixar vazio e preencher depois.
BLOCKED_NUMBERS=
